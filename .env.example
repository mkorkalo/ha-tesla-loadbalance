# Copy to .env and fill in. .env is never committed.

# Your time zone, e.g. Europe/Helsinki, Europe/Stockholm, Europe/Oslo
TZ=Europe/Helsinki

# Any long random strings. Generate each with:  openssl rand -base64 32
# Keep TESLAMATE_ENCRYPTION_KEY safe: TeslaMate encrypts your Tesla login with it.
TESLAMATE_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
